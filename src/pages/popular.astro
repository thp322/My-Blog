---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const postMap = Object.fromEntries(
  posts.map((p) => [p.slug, { title: p.data.title, date: p.data.date, tags: p.data.tags, description: p.data.description }]),
);
const dataUrl = '/view-counts.json';
---

<BaseLayout title="Popular" description="Most viewed articles on Harepr's blog">
  <section class="reveal">
    <header class="mb-12">
      <p class="label-caps text-vermilion mb-4">§ The Most-Read</p>
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3 flex flex-wrap items-baseline gap-x-4">
        Popular
        <span id="total-views" class="font-newsreader font-normal text-base text-ink-4 italic">&mdash;</span>
      </h1>
      <p class="font-newsreader text-lg text-ink-3 italic">Ranked by readership, the laurels of the journal.</p>
    </header>
    <div id="popular-list" class="space-y-1">
      <p class="font-newsreader text-ink-3 italic">Loading the ledger…</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ postMap, dataUrl }}>
  (() => {
    const CACHE_KEY = '__vc_data';
    const CACHE_VERSION = 2;
    const TTL = 5 * 60 * 1000;
    const DEBUG = false;
    const container = document.getElementById('popular-list');
    const posts = JSON.parse(JSON.stringify(postMap));

    function log(...args) {
      if (DEBUG) console.log('[Popular]', ...args);
    }

    function pad(n) { return String(n).padStart(2, '0'); }

    function isValidData(data) {
      return Array.isArray(data) && data.every(item => 
        item && typeof item.x === 'string' && typeof item.y === 'number'
      );
    }

    function render(data) {
      log('Rendering with data:', data);
      
      const list = Object.entries(posts)
        .map(([slug, meta]) => {
          const entry = isValidData(data) ? data.find((item) => item.x === `/posts/${slug}`) : null;
          const views = entry && entry.y >= 0 ? entry.y : 0;
          return { slug, ...meta, views };
        })
        .sort((a, b) => b.views - a.views);

      const total = list.reduce((sum, p) => sum + p.views, 0);
      const tv = document.getElementById('total-views');
      if (tv) tv.textContent = total > 0 ? `— ${total.toLocaleString()} total reads` : '';

      if (list.length === 0) {
        container.innerHTML = '<p class="font-newsreader text-ink-3 italic">No posts yet.</p>';
        return;
      }

      const rank = (i) => {
        if (i === 0) return `<span class="font-display font-semibold text-gold text-xl">1</span>`;
        return `<span class="font-mono text-sm text-ink-4 tabular-nums">${pad(i + 1)}</span>`;
      };

      container.innerHTML = list
        .map((post, i) => {
          const date = new Date(post.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
          const tags = post.tags?.map((t) => `<a href="/tags/${t}" class="font-mono text-xs text-ink-3 hover:text-vermilion no-underline transition-colors"><span class="text-vermilion">#</span>${t}</a>`).join(' ') || '';
          const viewsText = post.views > 0 ? `${post.views.toLocaleString()} reads` : '&mdash;';
          const isTop = i === 0;

          return `
            <article class="card-rule group flex items-baseline gap-5 py-4 border-b border-rule">
              <div class="w-8 shrink-0 text-center">${rank(i)}</div>
              <div class="flex-1 min-w-0">
                <a href="/posts/${post.slug}" class="font-display font-semibold text-ink text-lg leading-snug no-underline transition-colors group-hover:text-vermilion ${isTop ? 'md:text-xl' : ''}">${post.title}</a>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mt-1.5">
                  <time class="label-caps text-ink-4">${date}</time>
                  ${tags}
                </div>
              </div>
              <div class="label-caps text-ink-3 shrink-0 tabular-nums hidden sm:block">${viewsText}</div>
            </article>`;
        })
        .join('');
    }

    function fetchAndCache() {
      const now = Date.now();
      return fetch(dataUrl, {
        headers: { 'Accept': 'application/json', 'Cache-Control': 'no-cache' }
      })
        .then((r) => { 
          log('Fetch response:', r.status, r.statusText);
          if (!r.ok) throw new Error('bad status: ' + r.status); 
          return r.json(); 
        })
        .then((data) => {
          log('Fetched data:', data);
          if (!isValidData(data)) {
            log('Warning: invalid data format, using empty array');
            data = [];
          }
          try { 
            localStorage.setItem(CACHE_KEY, JSON.stringify({ 
              data, 
              ts: now,
              version: CACHE_VERSION 
            })); 
          } catch (e) { /* quota */ }
          return data;
        })
        .catch((err) => {
          log('Fetch failed:', err);
          return [];
        });
    }

    function loadCache() {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const cached = JSON.parse(raw);
        if (cached.version !== CACHE_VERSION) {
          log('Cache version mismatch, clearing cache');
          localStorage.removeItem(CACHE_KEY);
          return null;
        }
        if (cached.data && cached.ts && (Date.now() - cached.ts) < TTL) {
          log('Using cached data (age:', Math.round((Date.now() - cached.ts) / 1000), 's)');
          return cached.data;
        }
      } catch (e) { 
        log('Cache load error:', e);
      }
      return null;
    }

    // Always fetch fresh data, but use cache as immediate fallback
    const cached = loadCache();
    if (cached && isValidData(cached)) {
      log('Rendering from cache first');
      render(cached);
    } else {
      log('No valid cache, showing loading');
      container.innerHTML = '<p class="font-newsreader text-ink-3 italic">Loading the ledger…</p>';
    }

    // Always fetch fresh data in background
    fetchAndCache()
      .then((data) => {
        if (isValidData(data) && data.length > 0) {
          log('Rendering fresh data');
          render(data);
        } else if (!cached) {
          container.innerHTML = '<p class="font-newsreader text-ink-3 italic">暂无浏览数据。</p>';
        }
      })
      .catch((err) => { 
        log('Failed to load:', err);
        if (!cached) {
          container.innerHTML = '<p class="font-newsreader text-ink-3 italic">加载失败，请稍后重试。</p>';
        }
      });
  })();
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const postMap = Object.fromEntries(
  posts.map((p) => [p.slug, { title: p.data.title, date: p.data.date, tags: p.data.tags, description: p.data.description }]),
);
// Umami 公开分享链接的 shareId（从分享 URL https://umami.harperlog.cn/share/4gss9Vs0gz5lFjDd 提取）
const shareId = '4gss9Vs0gz5lFjDd';
const umamiHost = 'https://umami.harperlog.cn';
---

<BaseLayout title="Popular" description="Most viewed articles on Harepr's blog">
  <section class="reveal">
    <header class="mb-12">
      <p class="label-caps text-vermilion mb-4">§ The Most-Read</p>
      <h1 class="font-display font-semibold text-ink tracking-tight text-4xl md:text-5xl leading-[1.05] mb-3 flex flex-wrap items-baseline gap-x-4">
        Popular
        <span id="total-views" class="font-newsreader font-normal text-base text-ink-4 italic">&mdash;</span>
      </h1>
      <p class="font-newsreader text-lg text-ink-3 italic">Ranked by readership, the laurels of the journal.</p>
    </header>
    <div id="popular-list" class="space-y-1">
      <p class="font-newsreader text-ink-3 italic">Loading the ledger…</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ postMap, shareId, umamiHost }}>
  (() => {
    const DATA_CACHE_KEY = '__vc_data';
    const TOKEN_CACHE_KEY = '__vc_share_token';
    const DATA_TTL = 30 * 60 * 1000;
    const TOKEN_TTL = 55 * 60 * 1000;
    const container = document.getElementById('popular-list');
    const posts = JSON.parse(JSON.stringify(postMap));

    function pad(n) { return String(n).padStart(2, '0'); }

    function render(data) {
      const list = Object.entries(posts)
        .map(([slug, meta]) => {
          const entry = data && Array.isArray(data) ? data.find((item) => item.x === `/posts/${slug}`) : null;
          const views = entry && typeof entry.y === 'number' ? entry.y : 0;
          return { slug, ...meta, views };
        })
        .sort((a, b) => b.views - a.views);

      const total = list.reduce((sum, p) => sum + p.views, 0);
      const tv = document.getElementById('total-views');
      if (tv) tv.textContent = total > 0 ? `— ${total.toLocaleString()} total reads` : '';

      if (list.length === 0) {
        container.innerHTML = '<p class="font-newsreader text-ink-3 italic">No posts yet.</p>';
        return;
      }

      // rank glyph: gold laurel for #1, ink for others
      const rank = (i) => {
        if (i === 0) return `<span class="font-display font-semibold text-gold text-xl">1</span>`;
        return `<span class="font-mono text-sm text-ink-4 tabular-nums">${pad(i + 1)}</span>`;
      };

      container.innerHTML = list
        .map((post, i) => {
          const date = new Date(post.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
          const tags = post.tags?.map((t) => `<a href="/tags/${t}" class="font-mono text-xs text-ink-3 hover:text-vermilion no-underline transition-colors"><span class="text-vermilion">#</span>${t}</a>`).join(' ') || '';
          const viewsText = post.views > 0 ? `${post.views.toLocaleString()} reads` : '&mdash;';
          const isTop = i === 0;

          return `
            <article class="card-rule group flex items-baseline gap-5 py-4 border-b border-rule">
              <div class="w-8 shrink-0 text-center">${rank(i)}</div>
              <div class="flex-1 min-w-0">
                <a href="/posts/${post.slug}" class="font-display font-semibold text-ink text-lg leading-snug no-underline transition-colors group-hover:text-vermilion ${isTop ? 'md:text-xl' : ''}">${post.title}</a>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mt-1.5">
                  <time class="label-caps text-ink-4">${date}</time>
                  ${tags}
                </div>
              </div>
              <div class="label-caps text-ink-3 shrink-0 tabular-nums hidden sm:block">${viewsText}</div>
            </article>`;
        })
        .join('');
    }

    // Umami Share API 两步流程：
    // ① GET /api/share/{shareId} → 拿 token + websiteId
    // ② GET /api/websites/{websiteId}/metrics + x-umami-share-token header → 拿 metrics
    function fetchShareToken() {
      try {
        const raw = localStorage.getItem(TOKEN_CACHE_KEY);
        if (raw) {
          const cached = JSON.parse(raw);
          if (cached.token && cached.ts && (Date.now() - cached.ts) < TOKEN_TTL) {
            return Promise.resolve({ token: cached.token, websiteId: cached.websiteId });
          }
        }
      } catch (e) { /* ignore */ }

      return fetch(`${umamiHost}/api/share/${shareId}`, {
        headers: { 'Accept': 'application/json' }
      })
        .then((r) => { if (!r.ok) throw new Error('share token fetch failed'); return r.json(); })
        .then((info) => {
          const token = info.token;
          const websiteId = info.websiteId;
          if (!token || !websiteId) throw new Error('invalid share response');
          try {
            localStorage.setItem(TOKEN_CACHE_KEY, JSON.stringify({ token, websiteId, ts: Date.now() }));
          } catch (e) { /* ignore */ }
          return { token, websiteId };
        });
    }

    function fetchAndCache() {
      const now = Date.now();
      return fetchShareToken()
        .then(({ token, websiteId }) => {
          return fetch(`${umamiHost}/api/websites/${websiteId}/metrics?startAt=0&endAt=${now}&type=url`, {
            headers: {
              'Accept': 'application/json',
              'x-umami-share-token': token
            }
          });
        })
        .then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); })
        .then((data) => {
          try { localStorage.setItem(DATA_CACHE_KEY, JSON.stringify({ data, ts: now })); } catch (e) { /* quota */ }
          return data;
        })
        .catch(() => []);
    }

    function loadCache() {
      try {
        const raw = localStorage.getItem(DATA_CACHE_KEY);
        if (!raw) return null;
        const cached = JSON.parse(raw);
        if (cached.data && cached.ts && (Date.now() - cached.ts) < DATA_TTL) return cached.data;
      } catch (e) { /* ignore */ }
      return null;
    }

    const cached = loadCache();
    if (cached) { render(cached); return; }

    fetchAndCache()
      .then((data) => render(data))
      .catch(() => { container.innerHTML = '<p class="font-newsreader text-ink-3 italic">Failed to load the ledger.</p>'; });
  })();
</script>

---
const { slug } = Astro.props;
// Umami 公开分享链接的 shareId（从分享 URL https://umami.harperlog.cn/share/4gss9Vs0gz5lFjDd 提取）
const shareId = '4gss9Vs0gz5lFjDd';
const umamiHost = 'https://umami.harperlog.cn';
---

<span id={`vc-${slug}`} class="label-caps text-ink-4">
  &mdash;
</span>
<script define:vars={{ slug, shareId, umamiHost }}>
  (() => {
    const el = document.getElementById(`vc-${slug}`);
    if (!el) return;
    const pageUrl = `/posts/${slug}`;
    const DATA_CACHE_KEY = '__vc_data';
    const TOKEN_CACHE_KEY = '__vc_share_token';
    const DATA_TTL = 30 * 60 * 1000;   // metrics 缓存 30 分钟
    const TOKEN_TTL = 55 * 60 * 1000;  // share token 缓存 55 分钟

    function display(entry) {
      if (!entry || typeof entry.y !== 'number' || entry.y <= 0) { el.remove(); return; }
      el.textContent = entry.y === 1 ? '1 view' : `${entry.y} views`;
    }

    // Umami Share API 两步流程：
    // ① GET /api/share/{shareId} → 拿 token + websiteId
    // ② GET /api/websites/{websiteId}/metrics + x-umami-share-token header → 拿 metrics
    function fetchShareToken() {
      try {
        const raw = localStorage.getItem(TOKEN_CACHE_KEY);
        if (raw) {
          const cached = JSON.parse(raw);
          if (cached.token && cached.ts && (Date.now() - cached.ts) < TOKEN_TTL) {
            return Promise.resolve({ token: cached.token, websiteId: cached.websiteId });
          }
        }
      } catch (e) { /* ignore */ }

      return fetch(`${umamiHost}/api/share/${shareId}`, {
        headers: { 'Accept': 'application/json' }
      })
        .then((r) => { if (!r.ok) throw new Error('share token fetch failed'); return r.json(); })
        .then((info) => {
          const token = info.token;
          const websiteId = info.websiteId;
          if (!token || !websiteId) throw new Error('invalid share response');
          try {
            localStorage.setItem(TOKEN_CACHE_KEY, JSON.stringify({ token, websiteId, ts: Date.now() }));
          } catch (e) { /* ignore */ }
          return { token, websiteId };
        });
    }

    function fetchAndCache() {
      const now = Date.now();
      return fetchShareToken()
        .then(({ token, websiteId }) => {
          return fetch(`${umamiHost}/api/websites/${websiteId}/metrics?startAt=0&endAt=${now}&type=url`, {
            headers: {
              'Accept': 'application/json',
              'x-umami-share-token': token
            }
          });
        })
        .then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); })
        .then((data) => {
          try { localStorage.setItem(DATA_CACHE_KEY, JSON.stringify({ data, ts: now })); } catch (e) { /* quota exceeded, ignore */ }
          return data;
        });
    }

    function loadCache() {
      try {
        const raw = localStorage.getItem(DATA_CACHE_KEY);
        if (!raw) return null;
        const cached = JSON.parse(raw);
        if (cached.data && cached.ts && (Date.now() - cached.ts) < DATA_TTL) return cached.data;
      } catch (e) { /* corrupted, ignore */ }
      return null;
    }

    const cached = loadCache();
    if (cached) {
      display(cached.find((item) => item.x === pageUrl));
      return;
    }

    // One fetch shared by all ViewCounter instances on the page
    const memKey = '__vc_promise';
    if (!window[memKey]) {
      window[memKey] = fetchAndCache().catch(() => []);
    }

    window[memKey].then((data) => {
      display(data.find((item) => item.x === pageUrl));
    });
  })();
</script>
